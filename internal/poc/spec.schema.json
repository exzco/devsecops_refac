{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CVE fingerprint and vulnerability templates",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 2
    },
    "product_key": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "mapping_command": {
      "type": "string",
      "description": "仅输出奇安信鹰图 (Hunter) 空间测绘检索语法，例如 app.name=\"xxx\" 或 (web.title=\"xxx\" && header=\"xxx\")"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source": {
            "$ref": "#/$defs/text"
          },
          "text": {
            "$ref": "#/$defs/text"
          }
        },
        "required": [
          "source",
          "text"
        ]
      }
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/result"
      },
      "minItems": 2,
      "maxItems": 2
    }
  },
  "required": [
    "version",
    "product_key",
    "name",
    "mapping_command",
    "evidence",
    "results"
  ],
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "textList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      },
      "minItems": 1
    },
    "condition": {
      "type": "string",
      "enum": [
        "and",
        "or"
      ]
    },
    "part": {
      "type": "string",
      "enum": [
        "body",
        "header",
        "all"
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "fingerprint",
            "vulnerability"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "needs-evidence"
          ]
        },
        "reason": {
          "$ref": "#/$defs/text"
        },
        "missing_information": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "template": {
          "anyOf": [
            {
              "$ref": "#/$defs/template"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "status",
        "reason",
        "missing_information",
        "template"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "draft"
              }
            }
          },
          "then": {
            "properties": {
              "template": {
                "$ref": "#/$defs/template"
              }
            }
          },
          "else": {
            "properties": {
              "template": {
                "type": "null"
              },
              "missing_information": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^cve-[0-9]{4}-[0-9]{4,}-(fingerprint|verify)$"
        },
        "info": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "$ref": "#/$defs/text"
            },
            "author": {
              "$ref": "#/$defs/text"
            },
            "severity": {
              "type": "string",
              "enum": [
                "info",
                "low",
                "medium",
                "high",
                "critical",
                "unknown"
              ]
            },
            "description": {
              "$ref": "#/$defs/text"
            },
            "reference": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "tags": {
              "type": "string"
            },
            "metadata": {
              "type": "object"
            },
            "classification": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "cve-id": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/text"
                  }
                },
                "cwe-id": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/text"
                  }
                }
              },
              "required": []
            }
          },
          "required": [
            "name",
            "author",
            "severity",
            "description"
          ]
        },
        "http": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "method": {
                "type": "string",
                "enum": [
                  "GET",
                  "HEAD",
                  "POST",
                  "PUT",
                  "PATCH",
                  "DELETE",
                  "OPTIONS"
                ]
              },
              "path": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^\\{\\{(BaseURL|RootURL)\\}\\}(/|$)"
                },
                "minItems": 1
              },
              "headers": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "body": {
                "type": "string"
              },
              "redirects": {
                "type": "boolean"
              },
              "max-redirects": {
                "type": "integer",
                "minimum": 0
              },
              "matchers-condition": {
                "$ref": "#/$defs/condition"
              },
              "matchers": {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "type": {
                          "const": "word"
                        },
                        "words": {
                          "$ref": "#/$defs/textList"
                        },
                        "name": {
                          "type": "string"
                        },
                        "negative": {
                          "type": "boolean"
                        },
                        "part": {
                          "$ref": "#/$defs/part"
                        },
                        "condition": {
                          "$ref": "#/$defs/condition"
                        }
                      },
                      "required": [
                        "type",
                        "words",
                        "part",
                        "condition"
                      ]
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "type": {
                          "const": "regex"
                        },
                        "regex": {
                          "$ref": "#/$defs/textList"
                        },
                        "name": {
                          "type": "string"
                        },
                        "negative": {
                          "type": "boolean"
                        },
                        "part": {
                          "$ref": "#/$defs/part"
                        },
                        "condition": {
                          "$ref": "#/$defs/condition"
                        }
                      },
                      "required": [
                        "type",
                        "regex",
                        "part",
                        "condition"
                      ]
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "type": {
                          "const": "status"
                        },
                        "status": {
                          "type": "array",
                          "items": {
                            "type": "integer",
                            "minimum": 100,
                            "maximum": 599
                          },
                          "minItems": 1
                        },
                        "name": {
                          "type": "string"
                        },
                        "negative": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "type",
                        "status"
                      ]
                    }
                  ]
                },
                "minItems": 1
              },
              "extractors": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "regex"
                    },
                    "part": {
                      "$ref": "#/$defs/part"
                    },
                    "name": {
                      "type": "string"
                    },
                    "regex": {
                      "$ref": "#/$defs/textList"
                    },
                    "group": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "type",
                    "part",
                    "regex"
                  ]
                }
              }
            },
            "required": [
              "method",
              "path",
              "matchers-condition",
              "matchers"
            ]
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "info",
        "http"
      ]
    }
  }
}
